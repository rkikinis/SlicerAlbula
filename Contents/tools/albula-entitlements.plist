<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime must allow Albula: V8 writes the machine code it compiles JavaScript into and then runs
     it. Without these the app dies a second after launch (2026-11-03, the first Developer ID build). Used by the
     packaging script and the rebuild script. -->
<plist version="1.0"><dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict></plist>
